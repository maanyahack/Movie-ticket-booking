# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your REAL values.
#   cp .env.example .env
#
# .env holds your secrets. It is git-ignored, so it never goes
# to GitHub. This example file IS committed, so teammates (and
# future you) know which variables the app needs.
# ─────────────────────────────────────────────────────────────

# Port the Express server listens on. Port 5000 may be occupied by macOS AirPlay.
PORT=5001

# PostgreSQL connection string from Supabase:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your actual database password.
# (On some networks you must use the "Session pooler" URI on port 5432
#  instead of the direct URI on 5432 — if connection hangs, try that.)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Secret used to sign JWTs. Must be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Razorpay TEST mode keys — Dashboard → Settings → API Keys → "Test" keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_URL=http://localhost:5173
DATABASE_SSL=true
